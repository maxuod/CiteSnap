{
  "name": "@maxuod/citesnap",
  "version": "0.2.6",
  "private": true,
  "description": "Free GEO/AEO software to check AI mentions of companies, websites and products.",
  "type": "commonjs",
  "main": "index.cjs",
  "types": "index.d.ts",
  "bin": {
    "citesnap": "bin/citesnap.cjs",
    "answerpouch": "bin/answerpouch.cjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./protocol": "./lib/protocol.cjs",
    "./package.json": "./package.json",
    "./chrome-collector": "./lib/chrome-collector.cjs",
    "./browser-platforms": "./lib/browser-platforms.cjs",
    "./browser-extract": "./lib/browser-extract.cjs",
    "./platform-profiles": "./lib/platform-profiles.cjs",
    "./browser-environment": "./lib/browser-environment.cjs",
    "./egress-check": "./lib/egress-check.cjs",
    "./capture-artifact": "./lib/capture-artifact.cjs"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "lib/",
    "bin/",
    "README.md",
    "NOTICE.md",
    "docs/protocol.md",
    "source-provenance.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "check": "node --check index.cjs && node --check bin/citesnap.cjs && node --check desktop/main.cjs",
    "start": "node bin/answerpouch.cjs",
    "desktop": "electron desktop/main.cjs",
    "prepare-browser": "node scripts/prepare-browser.mjs",
    "package-desktop": "node scripts/package-desktop.mjs",
    "verify-desktop": "node scripts/verify-desktop.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "release-check": "node scripts/check-release.mjs",
    "verify-engine": "node scripts/verify-collection-engine.mjs",
    "review:public": "node scripts/review-public.mjs",
    "package-beta": "node scripts/create-beta-dmg.mjs"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "@types/node": "22.15.0",
    "electron": "45.2.1",
    "linkedom": "0.18.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxuod/CiteSnap.git"
  },
  "homepage": "https://github.com/maxuod/CiteSnap#readme",
  "bugs": {
    "url": "https://github.com/maxuod/CiteSnap/issues"
  },
  "productName": "CiteSnap"
}
